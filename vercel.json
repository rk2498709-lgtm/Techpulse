{
  "version": 2,
  "builds": [
    {
      "src": "server/src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/src/server.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "server/src/server.js"
    },
    {
      "src": "/robots.txt",
      "dest": "server/src/server.js"
    }
  ]
}
