# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide your local MongoDB or MongoDB Atlas URI below.
# If MongoDB is not reachable, the server gracefully initializes an in-memory database with pre-seeded data so you can run instantly.
MONGODB_URI=mongodb://127.0.0.1:27017/techpulse_blog

# JWT Authentication
JWT_SECRET=super_secret_techpulse_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# Default Admin Credentials (Auto-seeded if no admin exists)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@techpulse.io
ADMIN_PASSWORD=Admin@123456
ADMIN_ROLE=admin
